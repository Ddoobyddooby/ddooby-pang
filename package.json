{
  "name": "ddooby-pang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fonts:subset": "node scripts/subset-font.mjs",
    "stages:sim": "vitest run -c scripts/sim/sim.config.ts",
    "poc:deno": "vitest run -c scripts/server-poc/poc.config.ts && deno run --allow-read scripts/server-poc/deno/compare.ts supabase/functions/_shared/replay.js bundle",
    "server:shared": "node --disable-warning=ExperimentalWarning scripts/server-shared/build.ts",
    "server:shared:check": "node --disable-warning=ExperimentalWarning scripts/server-shared/build.ts --check",
    "functions:check": "deno check --no-lock --config supabase/functions/set-nickname/deno.json supabase/functions/set-nickname/index.ts && deno check --no-lock --config supabase/functions/start-run/deno.json supabase/functions/start-run/index.ts && deno check --no-lock --config supabase/functions/submit-score/deno.json supabase/functions/submit-score/index.ts",
    "supabase:check": "node --disable-warning=ExperimentalWarning scripts/supabase-check/rls-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:sync": "npm run build && cap sync android",
    "icons": "capacitor-assets generate --android --assetPath assets/app-icon"
  },
  "dependencies": {
    "@capacitor/android": "~8.5.3",
    "@capacitor/app": "~8.1.2",
    "@capacitor/core": "~8.5.3",
    "@capacitor/preferences": "~8.0.1",
    "@supabase/supabase-js": "2.119.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/assets": "~4.0.0",
    "@capacitor/cli": "~8.5.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
